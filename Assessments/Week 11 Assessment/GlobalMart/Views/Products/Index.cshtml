@model List<GlobalMart.Models.Product>

<style>
    body {
        font-family: Arial;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px solid #ddd;
        text-align: left;
    }

    th {
        background-color: #f4f4f4;
    }

    .btn {
        padding: 6px 12px;
        background: #007bff;
        color: white;
        border: none;
        cursor: pointer;
    }

    .success {
        background: #d4edda;
        padding: 10px;
        margin-top: 10px;
        color: #155724;
    }
</style>

<h2>GlobalMart — Product Catalog</h2>

@if (TempData["Message"] != null)
{
    <div class="success">@TempData["Message"]</div>
}

<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Product Name</th>
            <th>Base Price</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@Model[i].Name</td>
                <td>$@Model[i].Price.ToString("0.00")</td>
                <td>
                    <form method="post" action="/Products/AddToCart">
                        <input type="hidden" name="productId" value="@Model[i].Id" />
                        <button class="btn">Add to Cart 🛒</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<br />
<a href="/Cart/Index" class="btn">View Cart 🛒</a>
