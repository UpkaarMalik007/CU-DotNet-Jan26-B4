
@model List<FrontendMVC.ViewModel.DestinationViewModel>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">🌍 Travel Destinations</h2>
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            + Add New Destination
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-lg border-0 rounded-4 h-100">
                    <div class="card-body">
                        <h4 class="card-title text-primary fw-bold">
                            📍 @item.CityName
                        </h4>
                        <h6 class="text-muted mb-3">🌎 @item.Country</h6>

                        <p class="card-text">
                            @item.Description
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-warning text-dark fs-6">
                                ⭐ Rating: @item.Rating
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                ✏️ Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                🗑 Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>