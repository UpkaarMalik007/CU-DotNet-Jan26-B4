@model FrontendMVC.ViewModel.UpdateDestinationViewModel


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h3 class="mb-0">✈️ Edit Destination</h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post">

                        <div class="mb-3">
                            <label asp-for="CityName" class="form-label fw-bold"></label>
                            <input asp-for="CityName" class="form-control form-control-lg" placeholder="Enter city name" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Country" class="form-label fw-bold"></label>
                            <input asp-for="Country" class="form-control form-control-lg" placeholder="Enter country" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control form-control-lg" rows="4" placeholder="Enter description"></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Rating" class="form-label fw-bold"></label>
                            <input asp-for="Rating" class="form-control form-control-lg" placeholder="Enter rating" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                ← Back
                            </a>

                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                Update Destination
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>