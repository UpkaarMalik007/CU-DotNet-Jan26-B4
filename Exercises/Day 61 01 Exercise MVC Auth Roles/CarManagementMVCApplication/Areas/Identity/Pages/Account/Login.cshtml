@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid vh-100 overflow-hidden">
    <div class="row h-100">

        <!-- LEFT SIDE -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center bg-dark text-white">
            <div class="w-75">

                <div class="text-center mb-4">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/lotus.webp"
                         style="width:120px;" />
                    <h4 class="mt-3">We are The Lotus Team</h4>
                </div>

                <form method="post">

                    <p class="text-muted">Please login to your account</p>

                    <div class="p-3 bg-light rounded">
                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Email" class="form-control" placeholder="Email">
                            <label>Email</label>
                        </div>

                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password">
                            <label>Password</label>
                        </div>

                        <div class="form-check mb-3 text-dark">
                            <input asp-for="Input.RememberMe" class="form-check-input">
                            <label class="form-check-label">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">Log In</button>

                    <div class="text-center">
                        <a asp-page="./ForgotPassword" class="text-decoration-none">Forgot password?</a>
                    </div>

                    <div class="text-center mt-3">
                        <span>Don't have an account?</span>
                        <a asp-page="./Register" class="btn btn-outline-light btn-sm ms-2">Create New</a>
                    </div>

                </form>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center text-white"
             style="
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
        url('https://images.unsplash.com/photo-1503376780353-7e6692767b70');
        background-size: cover;
        background-position: center;
     ">

            <div class="w-75 text-center">
                <h3>We are more than just a company</h3>
                <p>
                    Manage your cars efficiently with our platform.
                    Track, update, and organize everything in one place.
                </p>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}