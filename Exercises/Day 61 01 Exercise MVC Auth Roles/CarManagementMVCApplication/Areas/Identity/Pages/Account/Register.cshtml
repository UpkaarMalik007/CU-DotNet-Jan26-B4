@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid vh-100">
    <div class="row h-100">

        <!-- LEFT SIDE -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center bg-gradient bg-dark text-white">
            <div class="w-75">

                <div class="text-center mb-4">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/lotus.webp"
                         style="width:120px;" />
                    <h4 class="mt-3">Join The Lotus Team</h4>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

                    <p class="text-muted">Create your account</p>


                    <div class="p-3 bg-light rounded">
                        <!-- all form-floating inputs here -->
                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Email" class="form-control" placeholder="Email">
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password">
                            <label asp-for="Input.Password">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3 text-dark">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password">
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    

                    <button type="submit" class="btn btn-primary w-100 mb-3">Register</button>

                    <div class="text-center">
                        <span>Already have an account?</span>
                        <a asp-page="./Login" class="btn btn-outline-light btn-sm ms-2">Login</a>
                    </div>

                </form>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        
        <div class="col-lg-6 d-flex align-items-center justify-content-center text-white"
             style="
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
        url('https://images.unsplash.com/photo-1503376780353-7e6692767b70');
        background-size: cover;
        background-position: center;
     ">

            <div class="w-75 text-center">
                <h3>We are more than just a company</h3>
                <p>
                    Join us and simplify your car management experience.
                    Everything you need, all in one place.
                </p>
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}