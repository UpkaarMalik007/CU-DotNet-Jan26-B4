@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid p-0">

    <!-- HERO SECTION -->
    <div class="d-flex align-items-center justify-content-center text-white text-center"
         style="
            height: 90vh;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
            url('https://images.unsplash.com/photo-1502877338535-766e1452684a');
            background-size: cover;
            background-position: center;
         ">

        <div>

            <!-- LOGO -->
            <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/lotus.webp"
                 alt="logo"
                 class="mb-3"
                 style="width:80px;">

            <!-- TITLE -->
            <h1 class="display-3 fw-bold">Lotus Cars</h1>

            <!-- TAGLINE -->
            <p class="lead mt-3">
                A dream of many, brought to life here.
            </p>

            @* <!-- BUTTON (optional) -->
            <a href="/Cars" class="btn btn-primary mt-3 px-4">Explore Cars</a> *@

        </div>

